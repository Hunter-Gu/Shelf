{
	"extends": "plasmo/templates/tsconfig.base",
	"exclude": ["node_modules"],
	"include": [".plasmo/index.d.ts", "./**/*.ts", "./**/*.tsx", "./index.d.ts"],
	"compilerOptions": {
		"strict": true,
		"strictNullChecks": true,
		"paths": {
			"~/*": ["./src/*"],
			"common/*": ["../common/src/*"]
		},
		"baseUrl": "."
	}
}
