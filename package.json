{
  "name": "Shelf",
  "displayName": "Shelf",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "An open-source, Arc-style Chrome sidebar that keeps your spaces, pinned links and favorites in your own Chrome bookmarks.",
  "author": "Neil Gu. <nail.gu.hunter@gmail.com>",
  "license": "MIT",
  "keywords": [
    "bookmarks",
    "browser-extension",
    "chrome-extension",
    "side-panel",
    "workspace",
    "wxt"
  ],
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.1.6",
    "@astryxdesign/theme-neutral": "^0.1.6",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@tanstack/react-virtual": "^3.10.8",
    "emoji-mart": "^5.6.0",
    "framer-motion": "^11.11.1",
    "lucide-react": "^0.446.0",
    "react": "^19.2.4",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.0.300",
    "@types/node": "^22.13.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1",
    "vitest": "^4.1.7",
    "wxt": "^0.20.27"
  }
}
